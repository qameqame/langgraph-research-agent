# Anthropic (Claude) APIキー: https://console.anthropic.com/
# 現在はOllama(ローカルLLM)を使う構成になっているため、このキーは必須ではない。
# tool_choiceの実験(step1_ex2)などでAnthropicに戻す場合のみ必要。
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Tavily検索APIキー(無料枠あり): https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Ollama: ローカルで起動しているOllamaサーバーのURL(通常は変更不要)
# OLLAMA_BASE_URL=http://localhost:11434
